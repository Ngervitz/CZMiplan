// Example local overrides — copy to js/config.local.js (gitignored).
// Enable B3 shadow against a local Express backend:
//
//   CZ_SHADOW_MODE = true;
//   CZ_BACKEND_API_URL = "http://localhost:3000";
//
// Or use query params without this file:
//   ?cz_shadow=1&cz_api=http://localhost:3000
//
// Never put MIPLAN_BACKEND_SECRET, Supabase keys, or Claude secrets here.
