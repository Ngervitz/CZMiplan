# Mi Plan backend — copy to server/.env locally. Never commit secrets.

PORT=3000
NODE_ENV=development

# Comma-separated browser origins. Production: explicit Vercel URL(s). Never *.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173

# Supabase CZMiplan (project ref hvrrywlddxpywuvqclyq) — server only
SUPABASE_URL=https://hvrrywlddxpywuvqclyq.supabase.co
SUPABASE_ANON_KEY=
MIPLAN_BACKEND_SECRET=
DEFAULT_TENANT_ID=miplan-default

# Reserved for later (prefer service_role when available on Railway):
# SUPABASE_SERVICE_ROLE_KEY=
