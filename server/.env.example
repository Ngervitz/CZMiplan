# Mi Plan backend — copy to server/.env locally. Never commit secrets.

PORT=3000
NODE_ENV=development

# Comma-separated browser origins. Production: explicit Vercel URL(s). Never *.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,https://cz-miplan2.vercel.app

# Supabase CZMiplan (project ref hvrrywlddxpywuvqclyq) — server only
SUPABASE_URL=https://hvrrywlddxpywuvqclyq.supabase.co
SUPABASE_ANON_KEY=
MIPLAN_BACKEND_SECRET=
DEFAULT_TENANT_ID=miplan-default

# A3 handoff — Mi Plan BE → JANUS redeem (dedicated Bearer; same value as JANUS MIPLAN_HANDOFF_REDEEM_SECRET)
# JANUS_HANDOFF_BASE_URL=https://mie-backend-production.up.railway.app
# MIPLAN_HANDOFF_REDEEM_SECRET=

# Reserved for later (prefer service_role when available on Railway):
# SUPABASE_SERVICE_ROLE_KEY=
